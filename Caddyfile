# Caddy gets free, automatic HTTPS (Let's Encrypt) for whatever domain you
# put here -- replace with your real Namecheap domain before starting.
# DNS must already point at this VM's IP for cert issuance to succeed.
your-domain.com {
	# API routes go to the FastAPI backend. Exact paths, not prefixes --
	# "/chat*" would also match "/chat.html" (the static page below) and
	# send it to the API instead, which has no route for it and 404s.
	handle /chat {
		reverse_proxy api:8000
	}
	handle /chat/voice {
		reverse_proxy api:8000
	}
	handle /tts {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	# ...everything else serves the static chat frontend.
	handle {
		root * /srv/frontend
		try_files {path} /chat.html
		file_server
	}
}
