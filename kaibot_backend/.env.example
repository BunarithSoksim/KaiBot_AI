# Copy this file to .env and fill in real values before switching providers
# away from "mock". Never commit the real .env file.

KAIBOT_LLM_PROVIDER=mock          # mock | gemini | claude
KAIBOT_LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

KAIBOT_EMBEDDING_PROVIDER=mock    # mock | gemini | cohere
COHERE_API_KEY=

KAIBOT_STT_PROVIDER=mock          # mock | google
KAIBOT_TTS_PROVIDER=mock          # mock | google
GOOGLE_APPLICATION_CREDENTIALS=   # path to service account JSON for Google STT/TTS
